{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.13.1"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://reprounds-api.oemerdigital.workers.dev",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "548195273503-nd3fenok612m32b255r54852qccsjk3u.apps.googleusercontent.com",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "REPLACE_WITH_REVENUECAT_ANDROID_SDK_KEY"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://reprounds-api.oemerdigital.workers.dev",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "548195273503-nd3fenok612m32b255r54852qccsjk3u.apps.googleusercontent.com",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "REPLACE_WITH_REVENUECAT_ANDROID_SDK_KEY"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE_WITH_PROD_API_ORIGIN",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "548195273503-nd3fenok612m32b255r54852qccsjk3u.apps.googleusercontent.com",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "REPLACE_WITH_REVENUECAT_ANDROID_SDK_KEY"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "alpha"
      }
    }
  }
}
