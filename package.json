{
  "name": "reprounds",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "eas-build-pre-install": "npm install -g corepack@latest && corepack enable && corepack prepare pnpm@11.6.0 --activate",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend start",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.103.0"
  }
}
