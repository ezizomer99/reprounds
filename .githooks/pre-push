#!/bin/sh
# RepRounds: scan the commits being pushed for secrets / sensitive files.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
root="$(git rev-parse --show-toplevel)"
scan="$root/.githooks/scan-secrets.sh"
z40="0000000000000000000000000000000000000000"
status=0

while read -r localref localsha remoteref remotesha; do
  [ "$localsha" = "$z40" ] && continue          # branch deletion, nothing to scan
  if [ "$remotesha" = "$z40" ]; then
    # New branch on the remote: scan commits not already on any remote ref.
    oldest="$(git rev-list "$localsha" --not --remotes | tail -1)"
    if [ -n "$oldest" ] && git rev-parse -q --verify "${oldest}^" >/dev/null 2>&1; then
      range="${oldest}^..$localsha"
    else
      range="$localsha"                          # includes a root commit; scan tip
    fi
  else
    range="$remotesha..$localsha"
  fi
  "$scan" range "$range" || status=1
done

exit $status
